{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "security:openssf-scorecard", "mergeConfidence:all-badges"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "osvVulnerabilityAlerts": true,
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "pre-commit": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "CI's actions, pinned by SHA with the version in a trailing comment.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "A runtime dependency changes what users install, so it lands as a fix.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "fix"
    },
    {
      "description": "npm packages wait longer before an update is proposed.",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "14 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Fleet release the end-to-end tests run against.",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["FLEET_VERSION: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "Thurbeen/thurbox",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}
