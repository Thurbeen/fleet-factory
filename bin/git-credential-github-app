#!/bin/sh
set -eu
cat >/dev/null
[ "${1:-}" = get ] || exit 0
bin_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if ! token=$("$FACTORY_NODE" "$bin_dir/github-app-token.ts" \
  --app-id "$FACTORY_GITHUB_APP_ID" \
  --installation-id "$FACTORY_GITHUB_INSTALLATION_ID" \
  --key-file "$FACTORY_GITHUB_APP_KEY_FILE" \
  --api-url "$FACTORY_GITHUB_API_URL"); then
  printf 'quit=1\n'
  exit 1
fi
printf 'username=x-access-token\npassword=%s\n' "$token"
