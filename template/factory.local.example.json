{
  "fleetBin": "/ABSOLUTE/PATH/fleet",
  "fleetReviewer": "/ABSOLUTE/PATH/fleet-reviewer",
  "runtime": { "kind": "runtime-mux" },
  "secrets": {
    "author-app": {
      "githubApp": {
        "appId": "AUTHOR_APP_ID",
        "installationId": "AUTHOR_INSTALLATION_ID",
        "keyFile": "/ABSOLUTE/PATH/author-app.private-key.pem"
      },
      "as": "GITHUB_TOKEN"
    },
    "reviewer-app": {
      "githubApp": {
        "appId": "REVIEWER_APP_ID",
        "installationId": "REVIEWER_INSTALLATION_ID",
        "keyFile": "/ABSOLUTE/PATH/reviewer-app.private-key.pem"
      },
      "as": "REVIEWER_TOKEN"
    },
    "observability-token": { "command": ["/ABSOLUTE/PATH/pass", "show", "obs"], "as": "OBS_TOKEN" }
  }
}
